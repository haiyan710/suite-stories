# ------------------------------------------------------------------
# Slack app credentials (https://api.slack.com/apps -> your app)
#   - SLACK_BOT_TOKEN:  OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
#     Required scopes: app_mentions:read, chat:write, im:history, reactions:write
#   - SLACK_APP_TOKEN:  Socket Mode -> App-Level Token (xapp-...)
#     Required connections scope: connections:write
# ------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# ------------------------------------------------------------------
# GLM model access (Z.ai / GLM Coding Plan)
# The bot talks to the Anthropic-compatible Messages API, the same
# transport ZCode itself uses for the "Z.ai Coding Plan" provider.
# Find your API key in the Z.ai key management console
# (https://z.ai/manage-apikey/apikey-list), or copy the value your
# ZCode install stores in ~/.zcode/v2/provider_config.json
# (config.providerConfigRules.providerRules[0].config.access.apiKey).
# ------------------------------------------------------------------
ZAI_API_KEY=your-zai-api-key
ZAI_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
GLM_MODEL=GLM-5.3-Flash

# ------------------------------------------------------------------
# Access control: comma-separated Slack user IDs allowed to use the
# bot. Everyone else is silently ignored (a warning is logged).
# Your user ID: Slack profile -> ... -> Copy member ID.
# ------------------------------------------------------------------
ALLOWED_SLACK_USER_IDS=U01234567,U89012345

# ------------------------------------------------------------------
# Optional configuration
# ------------------------------------------------------------------
# Where the SQLite database lives (created if missing)
DATABASE_PATH=data/hotel_agent.db
# Optional: your publication's domain, used to find existing coverage
# (searches become "site:<domain> <hotel>"). Leave blank if unsure.
PUBLICATION_DOMAIN=
# Request timeouts for web fetching, seconds
FETCH_TIMEOUT_SECONDS=25
# Max parallel page fetches during research
MAX_CONCURRENT_FETCHES=4
# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# LLM provider
#   zai        -> GLM via Z.ai (needs ZAI_API_KEY)
#   claude_cli -> runs the local `claude -p` (Claude Code CLI) under the
#                 Claude account logged in on this machine; no API key.
#                 ANTHROPIC_API_KEY is stripped from the child process.
# ------------------------------------------------------------------
LLM_PROVIDER=zai
# Optional: path to the claude binary and a model override (empty = CLI default)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=
# Sample drafts: "zai" = GLM writes (public evidence only, falls back to Claude);
# "claude_cli" = Claude always writes. Drafts from hotel-shared documents always use Claude.
WRITER_PROVIDER=zai
# Reuse facts verified within this many days when a hotel is researched again
# (0 = always research from scratch), if at least FACT_CACHE_MIN_FACTS exist.
FACT_CACHE_DAYS=60
FACT_CACHE_MIN_FACTS=20
# Default deliverable: why the hotel is worth booking + a day-by-day itinerary of this
# many nights when the request names no length ("4-night" overrides). 0 = one stay experience.
DEFAULT_TRIP_NIGHTS=3
# Research guest reviews, insider tips and hotel stories before editorial (0 = off).
EXPERIENCE_RESEARCH=1
# Rewrite sample drafts once to remove AI-writing tells before QA (0 = off).
HUMANIZE_DRAFTS=1
# Check itinerary travel times with free OpenStreetMap services (Photon geocoding, OSRM
# routing; no traffic data, no key). 0 = off.
LOGISTICS_CHECK=1
PHOTON_URL=https://photon.komoot.io/api/
OSRM_URL=https://routing.openstreetmap.de
